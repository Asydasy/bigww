{
  "name": "bigww-server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Backend BigWW — Fastify + PostgreSQL + Kysely",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "covers": "node src/covers.js",
    "test": "node --env-file-if-exists=.env.test --test test/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.3",
    "@fastify/oauth2": "^8.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "kysely": "^0.27.5",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=22"
  }
}
