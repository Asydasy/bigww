# Skopiuj ten plik do .env i uzupełnij. .env nie trafia do repozytorium.
#
# Do samego "docker compose up" ten plik NIE jest potrzebny — compose podaje
# sensowne wartości domyślne, a serwer startuje z ostrzeżeniem o kluczu
# testowym. Ten plik jest do pracy bez Dockera, do Discorda i do produkcji.

# Baza. Przy docker compose zostaw tak jak jest — w sieci Dockera baza nazywa
# się "db" i compose podstawia własny adres, ten z pliku jest do pracy lokalnej.
DATABASE_URL="postgresql://bigww:bigww@localhost:5432/bigww"

# Klucz do podpisywania sesji. WYGENERUJ WŁASNY, np.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Bez niego serwer wstanie tylko poza produkcją i wypisze ostrzeżenie.
JWT_SECRET="zmien-mnie-na-losowy-ciag-znakow"

PORT=3000
HOST=0.0.0.0

# Skąd wolno wołać API. Przy SERVE_STATIC=1 front i API są pod jednym adresem
# i CORS nie jest potrzebny; dopisz tu port, jeśli serwujesz front osobno
# (np. "python -m http.server 8000").
CORS_ORIGIN="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"

# Publiczny adres serwera — tu wraca Discord po zalogowaniu.
PUBLIC_URL="http://localhost:3000"
# Gdzie odesłać przeglądarkę po udanym logowaniu.
FRONT_URL="http://localhost:3000/index.html"

# Logowanie przez Discorda. Bez tych dwóch wartości działa tylko e-mail
# z hasłem, a przycisk "Discord" na froncie mówi, że nie jest skonfigurowany.
# Zakładasz aplikację na https://discord.com/developers/applications
# i w zakładce OAuth2 dodajesz redirect: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# 1 = serwer oddaje też pliki frontu (wtedy wszystko pod http://localhost:3000).
# Przy docker compose jest to domyślnie włączone.
SERVE_STATIC=1

LOG_LEVEL=info
