# Skopiuj ten plik do .env i uzupełnij. .env nie trafia do repozytorium.

# Baza. Przy docker compose zostaw tak jak jest.
DATABASE_URL="postgresql://bigww:bigww@localhost:5432/bigww"

# Klucz do podpisywania sesji. WYGENERUJ WŁASNY, np.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="zmien-mnie-na-losowy-ciag-znakow"

PORT=3000
HOST=0.0.0.0

# Skąd wolno wołać API. Front otwarty przez "python -m http.server 8000".
CORS_ORIGIN="http://localhost:8000"

# Publiczny adres serwera — tu wraca Discord po zalogowaniu.
PUBLIC_URL="http://localhost:3000"
# Gdzie odesłać przeglądarkę po udanym logowaniu.
FRONT_URL="http://localhost:8000/index.html"

# Logowanie przez Discorda. Bez tych dwóch wartości działa tylko e-mail z hasłem.
# Zakładasz aplikację na https://discord.com/developers/applications
# i w zakładce OAuth2 dodajesz redirect: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# 1 = serwer oddaje też pliki frontu (wtedy wszystko pod http://localhost:3000)
SERVE_STATIC=0

LOG_LEVEL=info
